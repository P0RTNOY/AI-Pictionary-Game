# Public Expo config. Values in this file are safe placeholders.
# Copy to .env.local for local Expo Go/dev-client runs.

# local | development | staging | production
EXPO_PUBLIC_APP_ENV=local

# EAS profile label shown in Beta debug.
EXPO_PUBLIC_BUILD_PROFILE=local

# Local simulator/default:
EXPO_PUBLIC_API_URL=http://localhost:8000

# Physical phone on LAN example:
# EXPO_PUBLIC_API_URL=http://192.168.1.114:8000

# Preview/staging example:
# EXPO_PUBLIC_API_URL=https://api-staging.your-domain.com

# Production example:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
