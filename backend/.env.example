# Environment modes: local, development, staging, production.
# DEBUG and AUTO_CREATE_TABLES default to true only for local/development/test.
ENV=local
DEBUG=true

# AI_PROVIDER can be mock, openrouter, or local.
# mock is deterministic and free for local development/tests.
AI_PROVIDER=mock
DATABASE_URL=sqlite:///./ai_pictionary.db
AUTO_CREATE_TABLES=true

# Local dev can use *. Staging/production should use explicit origins only:
# CORS_ALLOW_ORIGINS=https://your-preview-app.example,https://your-production-app.example
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Required when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# OpenRouter model IDs. Keep these in env/config because model availability changes.
OPENROUTER_MODEL_CONFUSING=openai/gpt-5-nano
OPENROUTER_MODEL_CONFUSING_EFFORT=low
OPENROUTER_MODEL_BALANCED=deepseek/deepseek-v3.2
OPENROUTER_MODEL_BALANCED_EFFORT=
OPENROUTER_MODEL_LITERAL=openai/gpt-5.2
OPENROUTER_MODEL_LITERAL_EFFORT=high
OPENROUTER_JUDGE_MODEL=openai/gpt-5-nano

# Backward-compatible aliases.
ARTIST_MODEL_LOW=openai/gpt-5-nano
ARTIST_MODEL_LOW_EFFORT=low
ARTIST_MODEL_MID=deepseek/deepseek-v3.2
ARTIST_MODEL_MID_EFFORT=
ARTIST_MODEL_HIGH=openai/gpt-5.2
ARTIST_MODEL_HIGH_EFFORT=high

# Required when AI_PROVIDER=local. Expected to expose an OpenAI-compatible
# /chat/completions endpoint, such as LM Studio, llama.cpp, vLLM, or Ollama proxy.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=

# Optional direct-provider keys for experiments/checking.
# The app runtime does not require these when OpenRouter is configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=

# Notification provider is mock in local dev. Expo push support should use
# provider=expo device tokens from POST /device-tokens later.
NOTIFICATION_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# Release-candidate staging/production checklist:
# ENV=staging or production
# DEBUG=false
# AUTO_CREATE_TABLES=false
# DATABASE_URL=postgresql+psycopg://...
# CORS_ALLOW_ORIGINS=https://your-app-origin.example
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=...
# NOTIFICATION_PROVIDER=expo
# EXPO_ACCESS_TOKEN=...
# Run: alembic upgrade head
# Health: GET /health
